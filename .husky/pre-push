#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

[ -n "$CI" ] && exit 0

# Toggle checks with: git config hooks.runChecks true|false (default: false)
RUN_CHECKS="$(git config --bool hooks.runChecks || echo false)"
if [ "$RUN_CHECKS" != "true" ]; then
  echo "pre-push: skipping lint/tests (enable with: git config hooks.runChecks true)"
  exit 0
fi

node node_modules/eslint/bin/eslint.js "src/**/*.ts" "src/**/*.html" || exit 1
node node_modules/@angular/cli/bin/ng.js test --watch=false || exit 1
